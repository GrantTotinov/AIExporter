{
  "name": "ai-exporter",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-store-rules.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:chrome": "npm run build && node -e \"require('fs').copyFileSync('manifest.chrome.json', 'dist/manifest.json')\"",
    "build:firefox": "npm run build && node -e \"require('fs').copyFileSync('manifest.firefox.json', 'dist/manifest.json')\"",
    "archive": "node scripts/archive.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/node": "^24.0.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "harfbuzzjs": "^1.6.2",
    "jspdf": "^4.2.1",
    "mathjax-full": "^3.2.2"
  }
}
