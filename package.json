{
  "name": "ai-exporter",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:chrome": "npm run build && copy manifest.chrome.json dist\\manifest.json",
    "build:firefox": "npm run build && copy manifest.firefox.json dist\\manifest.json"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
