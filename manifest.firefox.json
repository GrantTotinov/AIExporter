{
  "manifest_version": 3,
  "name": "Free AI Exporter - ChatGPT, Claude & Gemini to PDF, Images, MD, JSON & CSV",
  "version": "2.3.0",
  "description": "Free export and backup tool for ChatGPT, Claude and Gemini chats: PDF, Images, Markdown, JSON or CSV. Save to GitHub or clipboard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "clipboardWrite",
    "downloads",
    "storage"
  ],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gptchatdownloader@granttotinov.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["authenticationInfo", "websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pageBridge.js"],
      "matches": ["https://chatgpt.com/*"]
    }
  ],
  "action": {
    "default_title": "AI Exporter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html"
}
