{
  "manifest_version": 3,
  "name": "Free AI Exporter - ChatGPT, Claude & Gemini to PDF, Images, MD, JSON & CSV",
  "version": "2.3.0",
  "description": "Free export and backup for ChatGPT, Claude, Gemini, DeepSeek, Grok and Perplexity chats: PDF, Word, Markdown, JSON, CSV and more.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "clipboardWrite",
    "offscreen",
    "downloads",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://api.notion.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pageBridge.js"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "AI Exporter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html"
}
